menu "EKOS -- Data Providers"

    config PROVIDER_BATTERY
        bool "Enable Battery ADC Provider"
        default y
        help
            Reads battery voltage via ADC1_CH0 (GPIO1).
            Voltage divider: 680kΩ/150kΩ, LiPo 1S (3.0V–4.2V).
            Exposes: battery_pct (float), battery_voltage (float).

    config PROVIDER_BME280
        bool "Enable BME280 Provider (I2C)"
        default n
        help
            Bosch BME280 environmental sensor via I2C (GPIO14/GPIO21).
            Exposes: temperature (float), humidity (float),
                     pressure (float).

    config PROVIDER_BME680
        bool "Enable BME680 Provider (I2C)"
        default n
        help
            Bosch BME680 environmental sensor via I2C (GPIO14/GPIO21).
            Exposes: temperature (float), humidity (float),
                     pressure (float), gas_resistance (float).

    if PROVIDER_BME680
        config PROVIDER_BME680_HEATER_TEMP
            int "BME680 heater target temperature (°C)"
            default 320
            range 200 400
            help
                Target heater temperature in degrees Celsius for gas measurement.
                Typical value: 320°C. Higher values increase sensitivity but
                also power consumption and sensor wear.

        config PROVIDER_BME680_HEATER_DUR
            int "BME680 heater duration (ms)"
            default 150
            range 1 4032
            help
                Heater on-time in milliseconds for each gas measurement.
                Typical value: 150ms. Longer durations improve stability
                but increase measurement time and power consumption.
    endif

endmenu
